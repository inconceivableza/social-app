<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config>
        <domain includeSubdomains="true">inclan</domain>
        <domain includeSubdomains="true">vabl.dev</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
