    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">172.48.0.46</domain>
        <domain includeSubdomains="true">172.48.1.3</domain>
        <domain includeSubdomains="true">172.48.2.3</domain>
        <domain includeSubdomains="true">172.48.3.3</domain>
    </domain-config>
</network-security-config>

