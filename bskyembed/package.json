{
  "name": "bskyembed",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-snippet": "tsc --project tsconfig.snippet.json && serve -s dist -p 3000 -n",
    "build": "tsc && vite build",
    "build-snippet": "tsc --project tsconfig.snippet.json",
    "go-build": "tsc && vite build --mode go-templates --outDir dist-go",
    "go-build-snippet": "tsc --project tsconfig.snippet.json --outDir dist-go",
    "lint": "eslint --cache --ext .js,.jsx,.ts,.tsx src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atproto/api": "link:../../atproto/packages/api",
    "@atproto/lexicon": "link:../../atproto/packages/lexicon",
    "preact": "^10.4.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-legacy": "^7.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.19.0",
    "eslint-config-preact": "^1.3.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "postcss": "^8.4.38",
    "serve": "^14.2.5",
    "tailwindcss": "^3.4.3",
    "terser": "^5.43.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "resolutions": {
    "@atproto/common-web": "link:../../atproto/packages/common-web",
    "@atproto/lexicon": "link:../../atproto/packages/lexicon",
    "@atproto/syntax": "link:../../atproto/packages/syntax",
    "@atproto/xrpc": "link:../../atproto/packages/xrpc"
  }
}
